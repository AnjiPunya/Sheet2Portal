DATABASE_URL=postgresql+psycopg://sheet2portal:sheet2portal@localhost:5433/sheet2portal
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=26214400
MAX_ROWS_PER_SHEET=50000
SAMPLE_ROW_COUNT=20

# Chatbot (AI engine) -- used only for the chat assistant; everything else
# in this app (parsing, schema analysis, KPIs) stays deterministic.
# Leave unset locally and the chatbot reports itself as not configured
# rather than failing. Names match the existing Vedha/Orka project's Render
# service so those credentials can be reused there if that service is ever
# shared -- but Render env vars are NOT shared across services automatically,
# so a dedicated Sheet2Portal deployment needs its own copy of whichever of
# these it uses.
#
# Defaults: groq -> openai/gpt-oss-120b, gemini -> gemini-flash-latest,
# openrouter -> openrouter/free, cerebras -> gpt-oss-120b. Set exactly one
# CHATBOT_PROVIDER line; other keys act as fallbacks. CHATBOT_MODEL overrides the model for
# CHATBOT_PROVIDER only (a fallback provider keeps its own default).
# GEMINI_API_KEY_1 (Vedha's name) is also accepted for the Gemini key.
CHATBOT_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
CHATBOT_MODEL=
